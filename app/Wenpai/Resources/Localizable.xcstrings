    "不录就和强拍用同一个声音": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Aufnahme wird der Klang der betonten Zählzeit verwendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you skip it, the downbeat sound is used"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no lo grabas, se usa el sonido del tiempo fuerte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans enregistrement, le son du temps fort est utilisé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non lo registri, si usa il suono del tempo forte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音しない場合は強拍と同じ音を使います"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하지 않으면 강박과 같은 소리를 사용합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não gravar, usa o mesmo som do tempo forte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не записывать, используется звук сильной доли"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmezsen güçlü vuruşun sesi kullanılır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不录就和强拍用同一个声音"
          }
        },
