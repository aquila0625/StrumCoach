    "没收到足够的声音（%lld/8），请靠近手机、跟着每一拍扫一下再试一次。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Schall erkannt (%lld/8). Geh näher ans Handy, schlage auf jeder Zählzeit an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough sound picked up (%lld/8). Move closer to the phone, strum on every beat, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se captó suficiente sonido (%lld/8). Acércate al teléfono, rasguea en cada pulso e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de son capté (%lld/8). Rapprochez-vous du téléphone, grattez sur chaque temps et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suono insufficiente (%lld/8). Avvicinati al telefono, suona un colpo su ogni tempo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十分な音を拾えませんでした（%lld/8）。スマートフォンに近づき、毎拍ストロークしてもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 충분히 잡히지 않았어요 (%lld/8). 휴대폰에 가까이 가서 박마다 한 번씩 치고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Som insuficiente captado (%lld/8). Aproxime-se do celular, toque uma batida em cada tempo e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звука услышано слишком мало (%lld/8). Подойдите ближе к телефону, играйте на каждую долю и повторите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli ses alınamadı (%lld/8). Telefona yaklaş, her vuruşta bir kez çal ve tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没收到足够的声音（%lld/8），请靠近手机、跟着每一拍扫一下再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒收到足夠的聲音（%lld/8），請靠近手機、跟著每一拍掃一下再試一次。"
          }
        }
      }
    },
    "没有录到声音，请靠近麦克风再录一次": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Ton aufgenommen. Geh näher ans Mikrofon und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sound was recorded. Move closer to the microphone and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se grabó ningún sonido. Acércate al micrófono e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun son enregistré. Rapprochez-vous du micro et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suono registrato. Avvicinati al microfono e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音が録音されませんでした。マイクに近づいてもう一度録音してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 녹음되지 않았습니다. 마이크에 더 가까이 대고 다시 녹음해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum som foi gravado. Aproxime-se do microfone e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не записан. Поднесите телефон ближе и попробуйте ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kaydedilmedi. Mikrofona yaklaşıp tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有录到声音，请靠近麦克风再录一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有錄到聲音，請靠近麥克風再錄一次"
          }
        }
      }
    },
    "没有麦克风权限。请到系统设置里允许本 App 使用麦克风。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofonzugriff. Erlaube dieser App in den Einstellungen, das Mikrofon zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone access. Allow this app to use the microphone in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono. Permite que esta app use el micrófono en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au micro. Autorisez cette app à utiliser le micro dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al microfono. Consenti a questa app di usare il microfono in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが許可されていません。設定でこの App のマイク使用を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 권한이 없습니다. 설정에서 이 앱의 마이크 사용을 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao microfone. Permita que este app use o microfone em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к микрофону. Разрешите приложению использовать микрофон в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon izni yok. Ayarlar’dan bu uygulamanın mikrofonu kullanmasına izin ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请到系统设置里允许本 App 使用麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有麥克風權限。請到系統設定裡允許本 App 使用麥克風。"
          }
        }
      }
    },
