            "value": "Toca al ritmo para fijar el tempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez en rythme pour régler le tempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il tempo toccando a ritmo"
          }
        },
        "ja": {
