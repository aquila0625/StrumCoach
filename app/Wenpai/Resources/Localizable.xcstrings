    "强拍重、弱拍轻，和声音同步": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betonte Zählzeiten kräftig, unbetonte leicht, synchron zum Klang"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong beats heavy, weak beats light, synced with sound"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerte en tiempos fuertes, suave en débiles, sincronizado con el sonido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fort sur les temps forts, léger sur les faibles, synchronisé avec le son"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Battiti forti marcati, deboli leggeri, in sincrono con il suono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強拍は強く、弱拍は軽く。音と同期します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강박은 세게, 약박은 약하게, 소리와 동기화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempos fortes marcados, fracos leves, em sincronia com o som"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильная доля ощутимее, слабая легче; синхронно со звуком"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güçlü vuruş ağır, zayıf vuruş hafif; sesle senkron"
          }
