    "需要麦克风权限才能听你扫弦：请到系统设置里允许“扫弦教练”使用麦克风。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach braucht Mikrofonzugriff, um dein Spiel zu hören. Erlaube ihn in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach needs microphone access to hear your strumming. Go to Settings and allow it to use the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach necesita acceso al micrófono para oír tu rasgueo. Ve a Ajustes y permite que lo use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach a besoin d’accéder au micro pour écouter votre jeu. Allez dans Réglages et autorisez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach ha bisogno del microfono per ascoltare il tuo strumming. Vai in Impostazioni e consenti l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークを聴き取るにはマイクへのアクセスが必要です。「設定」で StrumCoach のマイクを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트럼을 들으려면 마이크 접근 권한이 필요해요. 설정에서 StrumCoach의 마이크 사용을 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O StrumCoach precisa de acesso ao microfone para ouvir sua batida. Vá em Ajustes e permita o uso do microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы слышать ваш бой, StrumCoach нужен доступ к микрофону. Разрешите его в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrumCoach’in strum’ını duyabilmesi için mikrofon erişimi gerekir. Ayarlar’dan mikrofon iznini ver."
          }
        },
