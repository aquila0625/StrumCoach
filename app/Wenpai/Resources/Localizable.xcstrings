    "快慢不太稳（偏差约 ±%lld 毫秒），先把速度调慢 10 BPM 练熟。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Timing schwankt (Abweichung etwa ±%lld ms). Geh zuerst 10 BPM langsamer, bis es sitzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your timing is uneven (off by about ±%lld ms). Slow down by 10 BPM until it feels solid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pulso es algo irregular (desviación de unos ±%lld ms). Baja 10 BPM hasta dominarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tempo manque de régularité (écart d’environ ±%lld ms). Ralentissez de 10 BPM jusqu’à être à l’aise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo è poco regolare (scarto di circa ±%lld ms). Rallenta di 10 BPM finché non lo padroneggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポがやや不安定です（ばらつき約 ±%lld ms）。まずは 10 BPM 遅くして慣れましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박이 다소 불안정해요 (편차 약 ±%lld ms). 먼저 속도를 10 BPM 낮춰서 익숙해지세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ritmo está irregular (desvio de cerca de ±%lld ms). Reduza 10 BPM até pegar firmeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темп плавает (отклонение около ±%lld мс). Сначала снизьте скорость на 10 BPM и отработайте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo pek düzgün değil (yaklaşık ±%lld ms sapma). Oturana kadar hızı 10 BPM düşür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快慢不太稳（偏差约 ±%lld 毫秒），先把速度调慢 10 BPM 练熟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快慢不太穩（偏差約 ±%lld 毫秒），先把速度調慢 10 BPM 練熟。"
          }
        }
      }
    },
