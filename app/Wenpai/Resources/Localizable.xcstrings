    "按节奏连续点按来设定速度": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo durch rhythmisches Tippen einstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap repeatedly in rhythm to set the tempo"
          }
        },
        "es": {
