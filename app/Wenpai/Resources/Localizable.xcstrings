        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel unter Start = schrittweise langsamer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A target lower than the start makes a gradual slow-down"
          }
        },
