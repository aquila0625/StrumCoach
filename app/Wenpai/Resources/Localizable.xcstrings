    "准备，跟着倒数和高亮（外放时不放节拍声）": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit machen: Folge dem Einzähler und der Hervorhebung (kein Klick über Lautsprecher)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get ready: follow the count-in and highlights (no click through the speaker)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárate: sigue la cuenta y el resaltado (sin metrónomo por el altavoz)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez-vous : suivez le décompte et la surbrillance (pas de clic au haut-parleur)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparati: segui il conteggio e l’evidenziazione (niente click dall’altoparlante)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備してください。カウントとハイライトに合わせて（スピーカー再生中はクリックなし）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비하세요. 카운트다운과 강조 표시를 따라가세요 (스피커 출력 시 박자 소리 없음)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-se: acompanhe a contagem e o destaque (sem clique no alto-falante)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьтесь: следуйте отсчёту и подсветке (через динамик метроном не звучит)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlan: geri sayımı ve vurgulamayı takip et (hoparlörde tık sesi çalmaz)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备，跟着倒数和高亮（外放时不放节拍声）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備，跟著倒數和高亮（外放時不放節拍聲）"
          }
        }
      }
    },
