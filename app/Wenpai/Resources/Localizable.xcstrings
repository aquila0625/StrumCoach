    "静音时保持心里的节拍，恢复时检查有没有跑快或跑慢": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte den Takt im Kopf und prüfe beim Wiedereinsatz, ob du schneller oder langsamer geworden bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the beat in your head while muted, then check whether you sped up or slowed down when it returns"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el pulso en tu cabeza durante el silencio y comprueba al volver si te adelantaste o atrasaste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le tempo en tête pendant le silence, puis vérifiez au retour si vous avez accéléré ou ralenti"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il battito nella mente e, al ritorno del suono, controlla se hai accelerato o rallentato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュート中は心の中でビートを保ち、再開したときに走っていないか、遅れていないか確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 중에도 마음속으로 박자를 유지하고, 소리가 돌아오면 빨라지거나 느려졌는지 확인하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o pulso na cabeça e, na volta do som, veja se você acelerou ou atrasou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ритм про себя, а когда звук вернётся, проверьте, не убежали ли вперёд и не отстали ли"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessizken vuruşu zihninizde sürdürün; ses geri gelince hızlanıp yavaşlamadığınızı kontrol edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音时保持心里的节拍，恢复时检查有没有跑快或跑慢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音時在心裡保持節拍，恢復時檢查有沒有跑快或跑慢"
          }
        }
      }
    },
