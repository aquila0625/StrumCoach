    "已校准：以后跟练会扣掉 %lld 毫秒的延迟。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibriert: Ab jetzt werden %lld ms Latenz abgezogen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrated: %lld ms of latency will be subtracted from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrado: a partir de ahora se restarán %lld ms de latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibré : %lld ms de latence seront désormais déduites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrato: d’ora in poi verranno sottratti %lld ms di latenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "校正しました。今後の練習では %lld ms の遅延を差し引きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 완료: 앞으로 연습할 때 %lld ms의 지연을 빼고 계산합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrado: de agora em diante, %lld ms de latência serão descontados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откалибровано: теперь будет вычитаться задержка %lld мс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibre edildi: bundan sonra %lld ms gecikme düşülecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校准：以后跟练会扣掉 %lld 毫秒的延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已校準：之後跟練會扣掉 %lld 毫秒的延遲。"
          }
        }
      }
    },
