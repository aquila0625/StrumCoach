    "整体平均快了 %lld 毫秒，有点抢拍，跟着高亮再稳一点。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schnitt bist du %lld ms vor der Zählzeit. Folge der Hervorhebung und werde etwas ruhiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On average you’re %lld ms ahead of the beat. Follow the highlight and settle in a bit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De media vas %lld ms por delante del pulso. Sigue el resaltado y tranquilízate un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, vous êtes %lld ms en avance sur le temps. Suivez la surbrillance et posez-vous un peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In media sei %lld ms in anticipo sul tempo. Segui l’evidenziazione e cerca di stare più calmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体で平均 %lld ms 早く、少し走り気味です。ハイライトに合わせて落ち着いて弾きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체적으로 평균 %lld ms 빨라서 박이 조금 앞서가요. 강조 표시를 따라 좀 더 안정적으로 쳐 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, você está %lld ms adiantado. Acompanhe o destaque e fique um pouco mais firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем вы опережаете долю на %lld мс. Следуйте подсветке и играйте спокойнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama olarak vuruşun %lld ms önündesin. Vurguyu takip edip biraz sakinleş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整体平均快了 %lld 毫秒，有点抢拍，跟着高亮再稳一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整體平均快了 %lld 毫秒，有點搶拍，跟著高亮再穩一點。"
          }
        }
      }
    },
    "整体平均慢了 %lld 毫秒，试着提前一点点下手。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schnitt bist du %lld ms hinter der Zählzeit. Versuche, etwas früher anzuschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On average you’re %lld ms behind the beat. Try striking a touch earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De media vas %lld ms por detrás del pulso. Intenta rasguear un poco antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, vous êtes %lld ms en retard sur le temps. Essayez d’attaquer un peu plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In media sei %lld ms in ritardo sul tempo. Prova ad attaccare un po’ prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体で平均 %lld ms 遅れています。ほんの少し早めに弾いてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체적으로 평균 %lld ms 늦어요. 아주 조금 먼저 쳐 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, você está %lld ms atrasado. Tente tocar um pouquinho antes."
          }
        },
        "ru": {
